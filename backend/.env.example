# 本地配置样例。复制为 .env 后按需修改：
#   bash:       cp .env.example .env
#   PowerShell: Copy-Item .env.example .env
#
# 本文件不含任何密钥，可安全提交进版本库。
# 应用层只在 LLM_API_KEY 为空时才启用桩实现，与 LLM_MOCK 的关系见下方说明。

# ---- 应用 ----
APP_NAME=Text2SQL 电商数据分析 Agent
DEBUG=false
LOG_LEVEL=INFO
# 逗号分隔。开发时前端跑在 5173 并由 vite 代理转发；部署后由 nginx 同源转发，可留空
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- LLM 网关 ----
# 留空时使用桩实现：generate 节点按问题关键词选择预置 SQL，链路可完整跑通但 SQL 不由模型生成。
# 填入密钥后需把 LLM_MOCK 置为 false，重启服务才会切到真实模型。
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
# 主模型连续失败时降级的目标模型，留空表示不启用降级
LLM_FALLBACK_MODEL=
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=2048
# true 强制使用桩实现（离线演示、单元测试）；false 走真实模型，需要同时提供密钥
LLM_MOCK=true

# ---- 存储 ----
# 默认位于 backend/data/ 下，一般不需要改。Windows 路径请写成 D:/xxx/ecommerce.db 形式，
# 反斜杠会被 .env 解析为转义字符。
# BUSINESS_DB_PATH=./data/ecommerce.db
# APP_DB_PATH=./data/app.db

# ---- SQL 安全沙箱 ----
SQL_TIMEOUT_SECONDS=10
SQL_MAX_ROWS=1000
# 首次生成之外允许修正的次数，与它相加得到最大尝试次数
SQL_MAX_RETRY=3
SQL_SCAN_LIMIT=20000000

# ---- 会话 ----
# 历史会话回灌给模型的最近轮数
HISTORY_WINDOW=6
# memory：图状态保存在进程内，重启后丢失；sqlite：落 data/app.db，可跨重启恢复
CHECKPOINTER=memory

# ---- 审计日志 ----
# 关闭后审计完全静默（不写库也不写日志）。应用库不可写时会自动降级为日志输出，
# 与本项无关。审计记守卫判定与 SQL 执行，查询见 /api/audit
AUDIT_ENABLED=true
