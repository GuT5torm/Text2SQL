# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/

# ---- 虚拟环境（本机已有 backend/.venv，不入版本库）----
.venv/
venv/
env/

# ---- 本机配置与密钥 ----
# .env 含 LLM_API_KEY 等敏感项，只提交 .env.example
.env
.env.*
!.env.example

# ---- 运行时数据 ----
# ecommerce.db 由 data/seed.py 以固定随机种子生成，可随时复现，不入库；
# app.db 为会话历史与检查点的运行时产物。
backend/data/*.db
backend/data/*.db-wal
backend/data/*.db-shm

# ---- 临时与日志 ----
backend/_*.txt
*.log
.pytest_cache/
.coverage
htmlcov/

# ---- 评测输出 ----
# report.json 是每次跑评测的快照，内容可由 cases.yaml 复现，不入库
backend/eval/results/
backend/eval/report.json

# ---- 部署运行产物 ----
deploy/logs/

# ---- 前端 ----
frontend/node_modules/
frontend/dist/
frontend/.vite/
# 本机 npm 缓存目录。默认的 %LOCALAPPDATA%\npm-cache 在本机受权限限制，
# 安装时用 --cache .npm-cache 指到这里
frontend/.npm-cache/

# ---- PPT 编译服务运行时（slidep 守护进程 pid、日志、状态）----
.slidep/

# ---- 工具与编辑器私有数据 ----
.workbuddy/
.vscode/
.idea/
.DS_Store

# ---- 外部参考资料（版权不属于本项目）----
参考/
