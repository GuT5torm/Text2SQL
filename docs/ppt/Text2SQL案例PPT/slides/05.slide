<Slide style={{ background: '#FFFFFF', padding: '32px 56px 24px 56px' }}>
        <Box style={{ height: 84, flexDirection: 'row', alignItems: 'center', gap: 16 }}>
        <Box style={{ width: 6, height: 44, background: '#3B82F6' }} />
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0F172A', fontFamily: '微软雅黑' }}>
            八个业务节点，三条出口
        </Text>
    </Box>

        <Box style={{ height: 548, flexDirection: 'row', gap: 32 }}>
                <Box style={{ width: 745, position: 'relative' }}>
            <Box style={{ width: 200, flexDirection: 'column' }}>
                {[
                    ['route', '意图路由', false],
                    ['retrieve', '口径召回', false],
                    ['generate', '生成 SQL', false],
                    ['validate', '守卫校验', true],
                    ['execute', '执行取数', false],
                    ['visualize', '图表决策', false],
                    ['summarize', '生成结论', false],
                ].map((row, i) => (
                    <Box key={i} style={{ flexDirection: 'column', alignItems: 'center' }}>
                        <Box style={{
                            width: 200, height: 46,
                            background: row[2] ? '#3B82F6' : 'rgba(59,130,246,0.12)',
                            borderLeft: row[2] ? '0px solid #3B82F6' : '4px solid #3B82F6',
                            borderRadius: 6,
                            flexDirection: 'row', alignItems: 'center', gap: 10,
                            padding: '0 14px',
                        }}>
                            <Text style={{
                                fontSize: 14, fontFamily: 'Consolas', fontWeight: 'bold',
                                color: row[2] ? '#FFFFFF' : '#3B82F6',
                            }}>{row[0]}</Text>
                            <Text style={{
                                fontSize: 15, fontFamily: '微软雅黑',
                                color: row[2] ? '#FFFFFF' : '#0F172A',
                            }}>{row[1]}</Text>
                        </Box>
                        {i < 6 ? (
                            <Box style={{ flexDirection: 'column', alignItems: 'center', height: 16 }}>
                                <Box style={{ width: 2, height: 8, background: '#3B82F6' }} />
                                <Box style={{
                                    width: 0, height: 0,
                                    borderLeft: '6px solid transparent',
                                    borderRight: '6px solid transparent',
                                    borderTop: '8px solid #3B82F6',
                                }} />
                            </Box>
                        ) : null}
                    </Box>
                ))}
            </Box>

                        <Box style={{ position: 'absolute', left: 320, top: 250, width: 190, height: 46,
                background: '#06B6D4', borderRadius: 6,
                flexDirection: 'row', alignItems: 'center', gap: 10, padding: '0 14px' }}>
                <Text style={{ fontSize: 14, fontFamily: 'Consolas', fontWeight: 'bold', color: '#FFFFFF' }}>fix</Text>
                <Text style={{ fontSize: 15, fontFamily: '微软雅黑', color: '#FFFFFF' }}>按报错修正</Text>
            </Box>
            <Box style={{ position: 'absolute', left: 200, top: 209, width: 215, height: 2, background: '#06B6D4' }} />
            <Box style={{ position: 'absolute', left: 415, top: 211, width: 2, height: 39, background: '#06B6D4' }} />
            <Box style={{ position: 'absolute', left: 409, top: 250, width: 0, height: 0,
                borderLeft: '6px solid transparent', borderRight: '6px solid transparent',
                borderTop: '8px solid #06B6D4' }} />
            <Box style={{ position: 'absolute', left: 240, top: 273, width: 80, height: 2, background: '#06B6D4' }} />
            <Box style={{ position: 'absolute', left: 240, top: 219, width: 2, height: 54, background: '#06B6D4' }} />
            <Box style={{ position: 'absolute', left: 200, top: 219, width: 40, height: 2, background: '#06B6D4' }} />
            <Box style={{ position: 'absolute', left: 192, top: 213, width: 0, height: 0,
                borderTop: '6px solid transparent', borderBottom: '6px solid transparent',
                borderRight: '8px solid #06B6D4' }} />
            <Text style={{ position: 'absolute', left: 432, top: 200, fontSize: 13,
                color: '#06B6D4', fontFamily: '微软雅黑' }}>校验未通过</Text>
            <Text style={{ position: 'absolute', left: 60, top: 196, fontSize: 13,
                color: '#06B6D4', fontFamily: '微软雅黑' }}>修正后回 validate，最多三次</Text>
            <Text style={{ position: 'absolute', left: 316, top: 304, width: 200, fontSize: 12,
                color: 'rgba(15,23,42,0.60)', fontFamily: '微软雅黑' }}>
                校验失败与执行报错共用这一个修正节点
            </Text>
        </Box>

                <Box style={{ width: 391, flexDirection: 'column' }}>
            <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#0F172A', fontFamily: '微软雅黑' }}>
                三条终态
            </Text>
            <Box style={{ height: 10 }} />
            {[
                ['respond', '闲聊类直接应答，不进入取数链路'],
                ['clarify', '信息不足先追问，不猜着出 SQL'],
                ['give_up', '修正次数用尽，返回末次语句与报错'],
            ].map((row, i) => (
                <Box key={i} style={{
                    flexDirection: 'row', gap: 12, alignItems: 'flex-start',
                    padding: '10px 0', borderBottom: '1px solid rgba(15,23,42,0.12)',
                }}>
                    <Text style={{ fontSize: 14, fontFamily: 'Consolas', fontWeight: 'bold', color: '#3B82F6', width: 76 }}>
                        {row[0]}
                    </Text>
                    <Text style={{ fontSize: 14, color: '#0F172A', lineHeight: 1.5, fontFamily: '微软雅黑' }}>
                        {row[1]}
                    </Text>
                </Box>
            ))}

            <Box style={{ height: 22 }} />
            <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#0F172A', fontFamily: '微软雅黑' }}>
                两个设计选择
            </Text>
            <Box style={{ height: 10 }} />
            {[
                ['修完回 validate，不回 execute', '重新走一遍完整校验，修正结果不能绕过守卫。'],
                ['报错原样回传', '数据库的原始报错交给模型，比让它自查更有效。'],
            ].map((row, i) => (
                <Box key={i} style={{
                    background: 'rgba(6,182,212,0.10)', borderRadius: 8,
                    padding: '14px 16px', marginBottom: 12, flexDirection: 'column', gap: 6,
                }}>
                    <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#0F172A', fontFamily: '微软雅黑' }}>
                        {row[0]}
                    </Text>
                    <Text style={{ fontSize: 14, color: 'rgba(15,23,42,0.76)', lineHeight: 1.5, fontFamily: '微软雅黑' }}>
                        {row[1]}
                    </Text>
                </Box>
            ))}
        </Box>
    </Box>

        <Box style={{ height: 32, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: 'rgba(15,23,42,0.60)', fontFamily: '微软雅黑' }}>
            Text2SQL 电商数据分析 Agent
        </Text>
        <Text style={{ fontSize: 14, color: 'rgba(15,23,42,0.60)', fontFamily: '微软雅黑' }}>05 / 12</Text>
    </Box>
</Slide>
