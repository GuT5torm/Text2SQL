<Slide style={{ background: '#FFFFFF', padding: '32px 56px 24px 56px' }}>
        <Box style={{ height: 84, flexDirection: 'row', alignItems: 'center', gap: 16 }}>
        <Box style={{ width: 6, height: 44, background: '#3B82F6' }} />
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0F172A', fontFamily: '微软雅黑' }}>
            真实运行截图
        </Text>
    </Box>

        <Box style={{ height: 548, flexDirection: 'column' }}>
        <Box style={{
            background: 'rgba(59,130,246,0.08)', borderRadius: 6,
            padding: '12px 18px', flexDirection: 'row', alignItems: 'center', gap: 14,
        }}>
            <Box style={{ width: 4, height: 34, background: '#3B82F6' }} />
            <Text style={{ fontSize: 15, color: '#0F172A', lineHeight: 1.5, fontFamily: '微软雅黑' }}>
                六个场景覆盖基础链路、趋势、多轮追问、口径澄清、危险拦截与 SQL 面板。截图取自非桩模式的真实运行，本版为占位框，取得素材后逐格替换。
            </Text>
        </Box>

        <Box style={{ height: 20 }} />

        <Box style={{ flexDirection: 'column', gap: 20, flex: 1 }}>
            {[0, 1].map((r) => (
                <Box key={r} style={{ flexDirection: 'row', gap: 24, flex: 1 }}>
                    {[
                        ['基础链路', '一句话出数，结果配图表与结论'],
                        ['趋势查询', '按月展开，图表类型由模型决策'],
                        ['多轮追问', '上下文承接，省略的主语不丢'],
                        ['口径澄清', '信息不足先追问，不猜着出 SQL'],
                        ['危险拦截', '越权语句在校验环节被挡下'],
                        ['SQL 面板', '本轮语句与结果集对使用者可见'],
                    ].slice(r * 3, r * 3 + 3).map((row, i) => (
                        <Box key={i} style={{
                            flex: 1,
                            background: 'rgba(15,23,42,0.04)',
                            border: '1px dashed rgba(15,23,42,0.30)',
                            borderRadius: 8,
                            alignItems: 'center', justifyContent: 'center',
                            flexDirection: 'column', gap: 10,
                        }}>
                            <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#3B82F6', fontFamily: '微软雅黑' }}>
                                {row[0]}
                            </Text>
                            <Text style={{
                                fontSize: 14, color: 'rgba(15,23,42,0.66)',
                                textAlign: 'center', fontFamily: '微软雅黑',
                            }}>
                                {row[1]}
                            </Text>
                            <Box style={{
                                background: 'rgba(255,255,255,0.90)',
                                border: '1px dashed rgba(15,23,42,0.30)',
                                borderRadius: 4, padding: '6px 14px',
                            }}>
                                <Text style={{ fontSize: 13, color: 'rgba(15,23,42,0.55)', fontFamily: '微软雅黑' }}>
                                    待回填：真实运行截图
                                </Text>
                            </Box>
                        </Box>
                    ))}
                </Box>
            ))}
        </Box>
    </Box>

        <Box style={{ height: 32, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: 'rgba(15,23,42,0.60)', fontFamily: '微软雅黑' }}>
            Text2SQL 电商数据分析 Agent
        </Text>
        <Text style={{ fontSize: 14, color: 'rgba(15,23,42,0.60)', fontFamily: '微软雅黑' }}>09 / 12</Text>
    </Box>
</Slide>
