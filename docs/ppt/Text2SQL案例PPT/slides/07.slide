<Slide style={{ background: '#FFFFFF', padding: '32px 56px 24px 56px' }}>
        <Box style={{ height: 84, flexDirection: 'row', alignItems: 'center', gap: 16 }}>
        <Box style={{ width: 6, height: 44, background: '#3B82F6' }} />
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0F172A', fontFamily: '微软雅黑' }}>
            执行前的最后一道闸
        </Text>
    </Box>

        <Box style={{ height: 548, flexDirection: 'row', gap: 32 }}>
                <Box style={{ width: 380, flexDirection: 'column' }}>
            <Box style={{ height: 150, flexDirection: 'row', alignItems: 'flex-end', gap: 14 }}>
                <Text style={{ fontSize: 96, fontWeight: 'bold', color: '#3B82F6', fontFamily: 'Consolas', lineHeight: 1.0 }}>
                    9
                </Text>
                <Box style={{ flexDirection: 'column', paddingBottom: 12 }}>
                    <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#0F172A', fontFamily: '微软雅黑' }}>
                        条守卫规则
                    </Text>
                    <Text style={{ fontSize: 14, color: 'rgba(15,23,42,0.62)', fontFamily: '微软雅黑' }}>
                        按固定顺序依次执行
                    </Text>
                </Box>
            </Box>

            <Box style={{ height: 20 }} />
            <Box style={{ width: '100%', height: 1, background: 'rgba(15,23,42,0.12)' }} />
            <Box style={{ height: 16 }} />

            <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#0F172A', fontFamily: '微软雅黑' }}>
                另有三层纵深
            </Text>
            <Box style={{ height: 12 }} />
            {[
                ['语法树层', '在解析后的语法树上判定，不做字符串匹配'],
                ['连接层', '只读连接；会话与评测数据写入独立库文件'],
                ['资源层', '行数上限 1000，执行超时 10 秒中断'],
            ].map((row, i) => (
                <Box key={i} style={{ flexDirection: 'column', marginBottom: 12 }}>
                    <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#06B6D4', fontFamily: '微软雅黑' }}>
                        {row[0]}
                    </Text>
                    <Text style={{ fontSize: 14, color: 'rgba(15,23,42,0.76)', lineHeight: 1.5, fontFamily: '微软雅黑' }}>
                        {row[1]}
                    </Text>
                </Box>
            ))}
        </Box>

                <Box style={{ width: 756, flexDirection: 'column' }}>
            <Table
                style={{ width: '100%', height: 548 }}
                defaultTextStyle={{ fontSize: 14, textAlign: 'left', fontFamily: '微软雅黑', color: '#0F172A' }}
                defaultCellStyle={{
                    padding: 8,
                    border: {
                        left: { width: 1, color: 'rgba(15,23,42,0.12)' },
                        right: { width: 1, color: 'rgba(15,23,42,0.12)' },
                        top: { width: 1, color: 'rgba(15,23,42,0.12)' },
                        bottom: { width: 1, color: 'rgba(15,23,42,0.12)' },
                    },
                }}
                cells={[
                    [
                        { text: '规则', textStyle: { bold: true, color: '#FFFFFF', fontSize: 15 }, cellStyle: { background: { color: '#3B82F6' } } },
                        { text: '内容', textStyle: { bold: true, color: '#FFFFFF', fontSize: 15 }, cellStyle: { background: { color: '#3B82F6' } } },
                        { text: '处理', textStyle: { bold: true, color: '#FFFFFF', fontSize: 15 }, cellStyle: { background: { color: '#3B82F6' } } },
                    ],
                    [
                        { text: 'R1', textStyle: { bold: true, fontFamily: 'Consolas' } },
                        '只允许单条语句',
                        '拦截',
                    ],
                    [
                        { text: 'R2', textStyle: { bold: true, fontFamily: 'Consolas' }, cellStyle: { background: { color: 'rgba(15,23,42,0.04)' } } },
                        { text: '只允许查询类语句（SELECT / UNION / EXCEPT / INTERSECT）', cellStyle: { background: { color: 'rgba(15,23,42,0.04)' } } },
                        { text: '拦截', cellStyle: { background: { color: 'rgba(15,23,42,0.04)' } } },
                    ],
                    [
                        { text: 'R3', textStyle: { bold: true, fontFamily: 'Consolas' } },
                        '不得出现建表、改数、删库等关键字',
                        '拦截',
                    ],
                    [
                        { text: 'R4', textStyle: { bold: true, fontFamily: 'Consolas' }, cellStyle: { background: { color: 'rgba(15,23,42,0.04)' } } },
                        { text: '表必须在语义层登记', cellStyle: { background: { color: 'rgba(15,23,42,0.04)' } } },
                        { text: '拦截并提示疑似编造', cellStyle: { background: { color: 'rgba(15,23,42,0.04)' } } },
                    ],
                    [
                        { text: 'R5', textStyle: { bold: true, fontFamily: 'Consolas' } },
                        '字段必须存在于所属表的元数据中',
                        '拦截并给出建议',
                    ],
                    [
                        { text: 'R6', textStyle: { bold: true, fontFamily: 'Consolas', color: '#06B6D4' }, cellStyle: { background: { color: 'rgba(6,182,212,0.14)' } } },
                        { text: '缺少 LIMIT 或超过上限时自动包裹', textStyle: { bold: true }, cellStyle: { background: { color: 'rgba(6,182,212,0.14)' } } },
                        { text: '自动改写（唯一）', textStyle: { bold: true }, cellStyle: { background: { color: 'rgba(6,182,212,0.14)' } } },
                    ],
                    [
                        { text: 'R7', textStyle: { bold: true, fontFamily: 'Consolas' } },
                        '多表查询必须带连接条件',
                        '拦截',
                    ],
                    [
                        { text: 'R8', textStyle: { bold: true, fontFamily: 'Consolas' }, cellStyle: { background: { color: 'rgba(15,23,42,0.04)' } } },
                        { text: '执行超时中断', cellStyle: { background: { color: 'rgba(15,23,42,0.04)' } } },
                        { text: '仓储层 progress handler', cellStyle: { background: { color: 'rgba(15,23,42,0.04)' } } },
                    ],
                    [
                        { text: 'R9', textStyle: { bold: true, fontFamily: 'Consolas' } },
                        '只允许白名单内的函数',
                        '拦截',
                    ],
                ]}
            />
        </Box>
    </Box>

        <Box style={{ height: 32, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: 'rgba(15,23,42,0.60)', fontFamily: '微软雅黑' }}>
            Text2SQL 电商数据分析 Agent
        </Text>
        <Text style={{ fontSize: 14, color: 'rgba(15,23,42,0.60)', fontFamily: '微软雅黑' }}>07 / 12</Text>
    </Box>
</Slide>
