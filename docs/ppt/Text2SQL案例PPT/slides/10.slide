<Slide style={{ background: '#FFFFFF', padding: '32px 56px 24px 56px' }}>
        <Box style={{ height: 84, flexDirection: 'row', alignItems: 'center', gap: 16 }}>
        <Box style={{ width: 6, height: 44, background: '#3B82F6' }} />
        <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0F172A', fontFamily: '微软雅黑' }}>
            准确率怎么测，测出来是多少
        </Text>
    </Box>

        <Box style={{ height: 548, flexDirection: 'row', gap: 32 }}>
                <Box style={{ width: 625, flexDirection: 'column' }}>
            <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#0F172A', fontFamily: '微软雅黑' }}>
                三组判据，互不替代
            </Text>
            <Box style={{ height: 12 }} />
            <Text style={{ fontSize: 15, color: 'rgba(15,23,42,0.74)', lineHeight: 1.6, fontFamily: '微软雅黑' }}>
                口径对了不代表链路能跑通，链路通了不代表危险语句拦得住。三组分开计分，任一组失守都不算可用。
            </Text>
            <Box style={{ height: 18 }} />
            {[
                ['口径召回', '32 道问法', '逐条比对期望命中的指标、维度、时间区间与空召回避，四项全中才算通过。'],
                ['端到端可执行', '10 道问法', '走完整条链路，判定是否产出可执行语句与结果集，不看措辞好不好。'],
                ['守卫拦截', '8 条诱导语句', '把危险语句注入生成节点，模拟模型被诱导的情形，判定是否被校验环节拦下。'],
            ].map((row, i) => (
                <Box key={i} style={{
                    flexDirection: 'row', gap: 14, marginBottom: 14,
                    background: i % 2 === 0 ? 'rgba(59,130,246,0.08)' : 'rgba(6,182,212,0.10)',
                    borderRadius: 6, padding: '14px 16px', alignItems: 'flex-start',
                }}>
                    <Box style={{ width: 118, flexDirection: 'column', gap: 3 }}>
                        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#0F172A', fontFamily: '微软雅黑' }}>
                            {row[0]}
                        </Text>
                        <Text style={{ fontSize: 13, color: 'rgba(15,23,42,0.60)', fontFamily: '微软雅黑' }}>
                            {row[1]}
                        </Text>
                    </Box>
                    <Text style={{ fontSize: 14, color: '#0F172A', lineHeight: 1.55, flex: 1, fontFamily: '微软雅黑' }}>
                        {row[2]}
                    </Text>
                </Box>
            ))}
            <Box style={{ height: 10 }} />
            <Box style={{
                background: 'rgba(15,23,42,0.04)', borderLeft: '4px solid #06B6D4',
                borderRadius: 6, padding: '14px 16px',
            }}>
                <Text style={{ fontSize: 14, color: '#0F172A', lineHeight: 1.55, fontFamily: '微软雅黑' }}>
                    时间锚点固定为 2026-09-15。相对时间词若随运行日期漂移，同一道题目的期望结果每天都会变，评测就失去意义。
                </Text>
            </Box>
        </Box>

                <Box style={{ width: 511, flexDirection: 'column' }}>
            {[
                ['32 / 32', '口径召回', '指标 30 · 维度 29 · 时间 24 · 空召 2，四项全中'],
                ['9 / 9', '端到端可执行', '另有 1 条走不到取数链路，未计入分母'],
                ['8 / 8', '守卫拦截', '诱导语句全部在校验环节被挡下'],
            ].map((row, i) => (
                <Box key={i} style={{
                    flexDirection: 'row', alignItems: 'center', gap: 16,
                    height: 88, marginBottom: 12,
                    background: '#FFFFFF', border: '1px solid rgba(15,23,42,0.12)',
                    borderLeft: '4px solid #3B82F6', borderRadius: 8, padding: '0 18px',
                }}>
                    <Text style={{ fontSize: 30, fontWeight: 'bold', color: '#3B82F6', fontFamily: 'Consolas', width: 108 }}>
                        {row[0]}
                    </Text>
                    <Box style={{ flexDirection: 'column', gap: 4, flex: 1 }}>
                        <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#0F172A', fontFamily: '微软雅黑' }}>
                            {row[1]}
                        </Text>
                        <Text style={{ fontSize: 13, color: 'rgba(15,23,42,0.66)', lineHeight: 1.45, fontFamily: '微软雅黑' }}>
                            {row[2]}
                        </Text>
                    </Box>
                </Box>
            ))}

            <Box style={{
                background: 'rgba(15,23,42,0.04)',
                border: '1px dashed rgba(15,23,42,0.30)',
                borderRadius: 8, padding: '14px 18px', height: 86,
                flexDirection: 'column', justifyContent: 'center', gap: 6,
            }}>
                <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#0F172A', fontFamily: '微软雅黑' }}>
                    真实模型下的端到端准确率
                </Text>
                <Text style={{ fontSize: 13, color: 'rgba(15,23,42,0.60)', fontFamily: '微软雅黑' }}>
                    待回填：需接入真实密钥后重跑 pipeline 组
                </Text>
            </Box>

            <Box style={{ height: 14 }} />
            <Text style={{ fontSize: 12, color: 'rgba(15,23,42,0.55)', lineHeight: 1.5, fontFamily: '微软雅黑' }}>
                上述三组数值取自 eval/report.json，生成时间 2026-09-15。端到端组当前在桩实现下运行，语句来自预置模板，因此该组只反映链路可用性，不代表模型生成质量。
            </Text>
        </Box>
    </Box>

        <Box style={{ height: 32, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: 'rgba(15,23,42,0.60)', fontFamily: '微软雅黑' }}>
            Text2SQL 电商数据分析 Agent
        </Text>
        <Text style={{ fontSize: 14, color: 'rgba(15,23,42,0.60)', fontFamily: '微软雅黑' }}>10 / 12</Text>
    </Box>
</Slide>
