<Slide style={{ background: '#FFFFFF', padding: 0, flexDirection: 'column' }}>
    {/* A3 页眉 */}
    <Box style={{
        width: '100%', height: 72, background: '#0E3F8C',
        flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between',
        padding: '0 40px',
    }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14 }}>
            <Box style={{ width: 5, height: 26, background: '#3D7BD9' }} />
            <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#FFFFFF', fontFamily: '微软雅黑' }}>
                做了什么，下一步做什么
            </Text>
        </Box>
        <Text style={{ fontSize: 15, color: 'rgba(255,255,255,0.7)', fontFamily: '微软雅黑' }}>
            总结与展望
        </Text>
    </Box>

    <Box style={{ flex: 1, flexDirection: 'column', padding: '20px 40px 0 40px', gap: 14 }}>
        <Box style={{ flexDirection: 'row', gap: 16, alignItems: 'flex-start' }}>
            {/* 已实现 */}
            <Box style={{ flex: 1, background: '#F0F5FC', border: { top: { width: 4, color: '#1E4FA8' } }, flexDirection: 'column', padding: 18, gap: 12 }}>
                <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#0E3F8C', fontFamily: '微软雅黑' }}>已实现</Text>
                <Box style={{ flexDirection: 'column', gap: 9 }}>
                    <Box style={{ flexDirection: 'column', gap: 2 }}>
                        <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#1E4FA8', fontFamily: '微软雅黑' }}>口径集中配置</Text>
                        <Text style={{ fontSize: 17, color: '#4A5568', fontFamily: '微软雅黑', lineHeight: 1.45 }}>七个指标的表达式、必带过滤与边界说明写入语义层</Text>
                    </Box>
                    <Box style={{ flexDirection: 'column', gap: 2 }}>
                        <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#1E4FA8', fontFamily: '微软雅黑' }}>状态机编排</Text>
                        <Text style={{ fontSize: 17, color: '#4A5568', fontFamily: '微软雅黑', lineHeight: 1.45 }}>十四个节点，含重试回环与六条终态出口</Text>
                    </Box>
                    <Box style={{ flexDirection: 'column', gap: 2 }}>
                        <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#1E4FA8', fontFamily: '微软雅黑' }}>双层校验</Text>
                        <Text style={{ fontSize: 17, color: '#4A5568', fontFamily: '微软雅黑', lineHeight: 1.45 }}>九条守卫管语句安全，口径签名管算的是不是那个量</Text>
                    </Box>
                    <Box style={{ flexDirection: 'column', gap: 2 }}>
                        <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#1E4FA8', fontFamily: '微软雅黑' }}>可信与测试</Text>
                        <Text style={{ fontSize: 17, color: '#4A5568', fontFamily: '微软雅黑', lineHeight: 1.45 }}>审计留痕、数字回溯，548 条测试覆盖九条规则</Text>
                    </Box>
                </Box>
            </Box>

            {/* 明确不做 */}
            <Box style={{ flex: 1, background: '#F7F9FC', border: { top: { width: 4, color: '#8B97A8' } }, flexDirection: 'column', padding: 18, gap: 12 }}>
                <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#0E3F8C', fontFamily: '微软雅黑' }}>明确不做</Text>
                <Box style={{ flexDirection: 'column', gap: 9 }}>
                    <Box style={{ flexDirection: 'column', gap: 2 }}>
                        <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#4A5568', fontFamily: '微软雅黑' }}>用户体系</Text>
                        <Text style={{ fontSize: 17, color: '#4A5568', fontFamily: '微软雅黑', lineHeight: 1.45 }}>不做注册鉴权，单机演示环境，审计只到会话粒度</Text>
                    </Box>
                    <Box style={{ flexDirection: 'column', gap: 2 }}>
                        <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#4A5568', fontFamily: '微软雅黑' }}>多租户</Text>
                        <Text style={{ fontSize: 17, color: '#4A5568', fontFamily: '微软雅黑', lineHeight: 1.45 }}>不做租户隔离，也不做读写分离</Text>
                    </Box>
                    <Box style={{ flexDirection: 'column', gap: 2 }}>
                        <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#4A5568', fontFamily: '微软雅黑' }}>容器编排</Text>
                        <Text style={{ fontSize: 17, color: '#4A5568', fontFamily: '微软雅黑', lineHeight: 1.45 }}>不走 Docker，本地直接启动，减少排查成本</Text>
                    </Box>
                    <Box style={{ flexDirection: 'column', gap: 2 }}>
                        <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#4A5568', fontFamily: '微软雅黑' }}>中间件</Text>
                        <Text style={{ fontSize: 17, color: '#4A5568', fontFamily: '微软雅黑', lineHeight: 1.45 }}>不引入向量库、缓存与消息队列</Text>
                    </Box>
                </Box>
            </Box>

            {/* 后续演进 */}
            <Box style={{ flex: 1, background: '#F7F9FC', border: { top: { width: 4, color: '#3D7BD9' } }, flexDirection: 'column', padding: 18, gap: 12 }}>
                <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#0E3F8C', fontFamily: '微软雅黑' }}>后续演进</Text>
                <Box style={{ flexDirection: 'column', gap: 9 }}>
                    <Box style={{ flexDirection: 'column', gap: 2 }}>
                        <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#3D7BD9', fontFamily: '微软雅黑' }}>换库</Text>
                        <Text style={{ fontSize: 17, color: '#4A5568', fontFamily: '微软雅黑', lineHeight: 1.45 }}>单表超过 500 万行时切换，仓储层接口已就位</Text>
                    </Box>
                    <Box style={{ flexDirection: 'column', gap: 2 }}>
                        <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#3D7BD9', fontFamily: '微软雅黑' }}>召回升级</Text>
                        <Text style={{ fontSize: 17, color: '#4A5568', fontFamily: '微软雅黑', lineHeight: 1.45 }}>表数量超过 30 张时，规则匹配改走向量检索</Text>
                    </Box>
                    <Box style={{ flexDirection: 'column', gap: 2 }}>
                        <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#3D7BD9', fontFamily: '微软雅黑' }}>审计归档</Text>
                        <Text style={{ fontSize: 17, color: '#4A5568', fontFamily: '微软雅黑', lineHeight: 1.45 }}>补保留期与定期清理，当前审计表无过期策略</Text>
                    </Box>
                    <Box style={{ flexDirection: 'column', gap: 2 }}>
                        <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#3D7BD9', fontFamily: '微软雅黑' }}>对比留痕</Text>
                        <Text style={{ fontSize: 17, color: '#4A5568', fontFamily: '微软雅黑', lineHeight: 1.45 }}>对比期查询补齐 SQL 原文与耗时记录</Text>
                    </Box>
                </Box>
            </Box>
        </Box>

        {/* 致谢条 */}
        <Box style={{ width: '100%', height: 116, background: '#0E3F8C', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 34px' }}>
            <Box style={{ flexDirection: 'column', gap: 6 }}>
                <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#FFFFFF', fontFamily: '微软雅黑' }}>
                    汇报完毕，请各位老师批评指正
                </Text>
                <Text style={{ fontSize: 18, color: 'rgba(255,255,255,0.78)', fontFamily: '微软雅黑' }}>
                    基于 Text2SQL 的电商数据分析 Agent　·　口径集中配置　执行前校验　结果可追溯
                </Text>
            </Box>
            <Box style={{ flexDirection: 'column', gap: 5, alignItems: 'flex-end' }}>
                <Text style={{ fontSize: 17, color: 'rgba(255,255,255,0.72)', fontFamily: '微软雅黑' }}>答辩人　{{姓名}}</Text>
                <Text style={{ fontSize: 17, color: 'rgba(255,255,255,0.72)', fontFamily: '微软雅黑' }}>指导老师　{{指导老师}}</Text>
                <Text style={{ fontSize: 17, color: 'rgba(255,255,255,0.72)', fontFamily: '微软雅黑' }}>学号　{{学号}}</Text>
            </Box>
        </Box>
    </Box>

    {/* D 页脚 */}
    <Box style={{ width: '100%', height: 40, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 40px' }}>
        <Text style={{ fontSize: 14, color: '#8B97A8', fontFamily: '微软雅黑' }}>Text2SQL 电商数据分析 Agent</Text>
        <Text style={{ fontSize: 15, color: '#1E4FA8', fontFamily: 'Times New Roman' }}>16 / 16</Text>
    </Box>
</Slide>
