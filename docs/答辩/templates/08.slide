<Slide style={{ background: '#FFFFFF', padding: 0, flexDirection: 'column' }}>
    {/* A3 页眉 */}
    <Box style={{
        width: '100%', height: 72, background: '#0E3F8C',
        flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between',
        padding: '0 40px',
    }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14 }}>
            <Box style={{ width: 5, height: 26, background: '#3D7BD9' }} />
            <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#FFFFFF', fontFamily: '微软雅黑' }}>
                十四个节点，六条出口
            </Text>
        </Box>
        <Text style={{ fontSize: 15, color: 'rgba(255,255,255,0.7)', fontFamily: '微软雅黑' }}>
            系统设计
        </Text>
    </Box>

    <Box style={{ flex: 1, flexDirection: 'column', padding: '18px 40px 0 40px', gap: 13 }}>
        <Text style={{ fontSize: 20, color: '#4A5568', fontFamily: '微软雅黑' }}>
            上图八个是主链路节点。连同修正节点与五个分支终态节点，状态机共十四个节点、六条终态出口。
        </Text>

        {/* 第一行节点 */}
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
            <Box style={{ flex: 1, height: 126, background: '#F7F9FC', border: { top: { width: 4, color: '#0E3F8C' } }, flexDirection: 'column', padding: 12, gap: 6 }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
                    <Box style={{ width: 24, height: 24, background: '#0E3F8C', alignItems: 'center', justifyContent: 'center' }}>
                        <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF', fontFamily: 'Times New Roman' }}>1</Text>
                    </Box>
                    <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#0E3F8C', fontFamily: '微软雅黑' }}>路由</Text>
                </Box>
                <Text style={{ fontSize: 16, color: '#4A5568', fontFamily: '微软雅黑', lineHeight: 1.45 }}>
                    判断是取数提问、追问改写，还是与数据无关的请求
                </Text>
            </Box>
            <Text style={{ fontSize: 22, color: '#1E4FA8', fontFamily: 'Times New Roman' }}>›</Text>
            <Box style={{ flex: 1, height: 126, background: '#F7F9FC', border: { top: { width: 4, color: '#0E3F8C' } }, flexDirection: 'column', padding: 12, gap: 6 }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
                    <Box style={{ width: 24, height: 24, background: '#0E3F8C', alignItems: 'center', justifyContent: 'center' }}>
                        <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF', fontFamily: 'Times New Roman' }}>2</Text>
                    </Box>
                    <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#0E3F8C', fontFamily: '微软雅黑' }}>召回</Text>
                </Box>
                <Text style={{ fontSize: 16, color: '#4A5568', fontFamily: '微软雅黑', lineHeight: 1.45 }}>
                    按问句匹配指标、维度与示例，未命中时显式告知
                </Text>
            </Box>
            <Text style={{ fontSize: 22, color: '#1E4FA8', fontFamily: 'Times New Roman' }}>›</Text>
            <Box style={{ flex: 1, height: 126, background: '#F7F9FC', border: { top: { width: 4, color: '#0E3F8C' } }, flexDirection: 'column', padding: 12, gap: 6 }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
                    <Box style={{ width: 24, height: 24, background: '#0E3F8C', alignItems: 'center', justifyContent: 'center' }}>
                        <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF', fontFamily: 'Times New Roman' }}>3</Text>
                    </Box>
                    <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#0E3F8C', fontFamily: '微软雅黑' }}>生成</Text>
                </Box>
                <Text style={{ fontSize: 16, color: '#4A5568', fontFamily: '微软雅黑', lineHeight: 1.45 }}>
                    组装 Prompt，输出候选 SQL 与选用的口径说明
                </Text>
            </Box>
            <Text style={{ fontSize: 22, color: '#1E4FA8', fontFamily: 'Times New Roman' }}>›</Text>
            <Box style={{ flex: 1, height: 126, background: '#E8EFF8', border: { top: { width: 4, color: '#1E4FA8' } }, flexDirection: 'column', padding: 12, gap: 6 }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
                    <Box style={{ width: 24, height: 24, background: '#1E4FA8', alignItems: 'center', justifyContent: 'center' }}>
                        <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF', fontFamily: 'Times New Roman' }}>4</Text>
                    </Box>
                    <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#0E3F8C', fontFamily: '微软雅黑' }}>校验</Text>
                </Box>
                <Text style={{ fontSize: 16, color: '#4A5568', fontFamily: '微软雅黑', lineHeight: 1.45 }}>
                    九条守卫加口径签名，两条都过才放行执行
                </Text>
            </Box>
        </Box>

        {/* 第二行节点 */}
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
            <Box style={{ flex: 1, height: 126, background: '#F7F9FC', border: { top: { width: 4, color: '#3D7BD9' } }, flexDirection: 'column', padding: 12, gap: 6 }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
                    <Box style={{ width: 24, height: 24, background: '#3D7BD9', alignItems: 'center', justifyContent: 'center' }}>
                        <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF', fontFamily: 'Times New Roman' }}>5</Text>
                    </Box>
                    <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#0E3F8C', fontFamily: '微软雅黑' }}>执行</Text>
                </Box>
                <Text style={{ fontSize: 16, color: '#4A5568', fontFamily: '微软雅黑', lineHeight: 1.45 }}>
                    只读连接执行，带超时与结果行数上限
                </Text>
            </Box>
            <Text style={{ fontSize: 22, color: '#1E4FA8', fontFamily: 'Times New Roman' }}>›</Text>
            <Box style={{ flex: 1, height: 126, background: '#F7F9FC', border: { top: { width: 4, color: '#3D7BD9' } }, flexDirection: 'column', padding: 12, gap: 6 }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
                    <Box style={{ width: 24, height: 24, background: '#3D7BD9', alignItems: 'center', justifyContent: 'center' }}>
                        <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF', fontFamily: 'Times New Roman' }}>6</Text>
                    </Box>
                    <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#0E3F8C', fontFamily: '微软雅黑' }}>选图</Text>
                </Box>
                <Text style={{ fontSize: 16, color: '#4A5568', fontFamily: '微软雅黑', lineHeight: 1.45 }}>
                    按维度个数与结果行数选择图型，并写明依据
                </Text>
            </Box>
            <Text style={{ fontSize: 22, color: '#1E4FA8', fontFamily: 'Times New Roman' }}>›</Text>
            <Box style={{ flex: 1, height: 126, background: '#F7F9FC', border: { top: { width: 4, color: '#3D7BD9' } }, flexDirection: 'column', padding: 12, gap: 6 }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
                    <Box style={{ width: 24, height: 24, background: '#3D7BD9', alignItems: 'center', justifyContent: 'center' }}>
                        <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF', fontFamily: 'Times New Roman' }}>7</Text>
                    </Box>
                    <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#0E3F8C', fontFamily: '微软雅黑' }}>补充</Text>
                </Box>
                <Text style={{ fontSize: 16, color: '#4A5568', fontFamily: '微软雅黑', lineHeight: 1.45 }}>
                    数据时效探针、对比基准与异常标记
                </Text>
            </Box>
            <Text style={{ fontSize: 22, color: '#1E4FA8', fontFamily: 'Times New Roman' }}>›</Text>
            <Box style={{ flex: 1, height: 126, background: '#F7F9FC', border: { top: { width: 4, color: '#D9534F' } }, flexDirection: 'column', padding: 12, gap: 6 }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
                    <Box style={{ width: 24, height: 24, background: '#3D7BD9', alignItems: 'center', justifyContent: 'center' }}>
                        <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF', fontFamily: 'Times New Roman' }}>8</Text>
                    </Box>
                    <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#0E3F8C', fontFamily: '微软雅黑' }}>总结</Text>
                </Box>
                <Text style={{ fontSize: 16, color: '#4A5568', fontFamily: '微软雅黑', lineHeight: 1.45 }}>
                    写结论，并核对结论里的数字是否都出自结果集
                </Text>
            </Box>
        </Box>

        {/* 修正回环 + 六条终态出口 */}
        <Box style={{ flexDirection: 'row', gap: 14 }}>
            <Box style={{ flex: 1, background: '#E8EFF8', border: { left: { width: 4, color: '#D9534F' } }, padding: '14px 16px', flexDirection: 'column', gap: 3 }}>
                <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#0E3F8C', fontFamily: '微软雅黑' }}>
                    修正节点：回到校验，不绕过校验
                </Text>
                <Text style={{ fontSize: 16, color: '#4A5568', fontFamily: '微软雅黑', lineHeight: 1.45 }}>
                    校验或执行失败时进入，把数据库原始报错一并带回，修正后重走校验，上限 3 次。
                </Text>
            </Box>
            <Box style={{ flex: 1, background: '#F7F9FC', border: { left: { width: 4, color: '#1E4FA8' } }, padding: '14px 16px', flexDirection: 'column', gap: 3 }}>
                <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#0E3F8C', fontFamily: '微软雅黑' }}>六条终态出口</Text>
                <Text style={{ fontSize: 16, color: '#4A5568', fontFamily: '微软雅黑', lineHeight: 1.45 }}>
                    正常总结　·　闲聊应答　·　信息不足转澄清　·　域外请求拒答　·　归因只给拆解不给数字　·　重试超限放弃
                </Text>
            </Box>
        </Box>

        <Text style={{ fontSize: 14, color: '#8B97A8', fontFamily: '微软雅黑' }}>
            节点与出口取自 backend/app/agent/graph.py 的 add_node、add_conditional_edges 与 add_edge 声明，共 14 个节点、6 条终态出口。
        </Text>
    </Box>

    {/* D 页脚 */}
    <Box style={{ width: '100%', height: 40, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 40px' }}>
        <Text style={{ fontSize: 14, color: '#8B97A8', fontFamily: '微软雅黑' }}>Text2SQL 电商数据分析 Agent</Text>
        <Text style={{ fontSize: 15, color: '#1E4FA8', fontFamily: 'Times New Roman' }}>08 / 16</Text>
    </Box>
</Slide>
