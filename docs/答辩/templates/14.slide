<Slide style={{ background: '#FFFFFF', padding: 0, flexDirection: 'column' }}>
    {/* A3 页眉 */}
    <Box style={{
        width: '100%', height: 72, background: '#0E3F8C',
        flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between',
        padding: '0 40px',
    }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14 }}>
            <Box style={{ width: 5, height: 26, background: '#3D7BD9' }} />
            <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#FFFFFF', fontFamily: '微软雅黑' }}>
                真实运行演示
            </Text>
        </Box>
        <Text style={{ fontSize: 15, color: 'rgba(255,255,255,0.7)', fontFamily: '微软雅黑' }}>
            验证与演示
        </Text>
    </Box>

    <Box style={{ flex: 1, flexDirection: 'column', padding: '18px 40px 0 40px', gap: 12 }}>
        {/* 第一行 */}
        <Box style={{ flexDirection: 'row', gap: 14 }}>
            <Box style={{ flex: 1, flexDirection: 'column', gap: 6 }}>
                <Image src='assets/01_basic_pipeline.png' style={{ width: '100%', height: 200, objectFit: 'contain', border: { width: 1, color: '#D6DCE5' } }} />
                <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#1E4FA8', fontFamily: '微软雅黑' }}>基础链路</Text>
                <Text style={{ fontSize: 15, color: '#8B97A8', fontFamily: '微软雅黑' }}>结论、时效标注、异常标记、图表与结果表</Text>
            </Box>
            <Box style={{ flex: 1, flexDirection: 'column', gap: 6 }}>
                <Image src='assets/02_trend.png' style={{ width: '100%', height: 200, objectFit: 'contain', border: { width: 1, color: '#D6DCE5' } }} />
                <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#1E4FA8', fontFamily: '微软雅黑' }}>趋势问题</Text>
                <Text style={{ fontSize: 15, color: '#8B97A8', fontFamily: '微软雅黑' }}>横轴为时间且行数大于 3，选折线并写明依据</Text>
            </Box>
            <Box style={{ flex: 1, flexDirection: 'column', gap: 6 }}>
                <Image src='assets/03_followup_check.png' style={{ width: '100%', height: 200, objectFit: 'contain', border: { width: 1, color: '#D6DCE5' } }} />
                <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#1E4FA8', fontFamily: '微软雅黑' }}>多轮追问</Text>
                <Text style={{ fontSize: 15, color: '#8B97A8', fontFamily: '微软雅黑' }}>「那上个月呢」被改写为完整问句，并校验结论数字</Text>
            </Box>
        </Box>

        {/* 第二行 */}
        <Box style={{ flexDirection: 'row', gap: 14 }}>
            <Box style={{ flex: 1, flexDirection: 'column', gap: 6 }}>
                <Image src='assets/04_guard_block.png' style={{ width: '100%', height: 200, objectFit: 'contain', border: { width: 1, color: '#D6DCE5' } }} />
                <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#1E4FA8', fontFamily: '微软雅黑' }}>越权请求</Text>
                <Text style={{ fontSize: 15, color: '#8B97A8', fontFamily: '微软雅黑' }}>「清理一批无效订单」被挡回，全程只走两个阶段</Text>
            </Box>
            <Box style={{ flex: 1, flexDirection: 'column', gap: 6 }}>
                <Image src='assets/05_sql_panel.png' style={{ width: '100%', height: 200, objectFit: 'contain', border: { width: 1, color: '#D6DCE5' } }} />
                <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#1E4FA8', fontFamily: '微软雅黑' }}>技术细节</Text>
                <Text style={{ fontSize: 15, color: '#8B97A8', fontFamily: '微软雅黑' }}>执行的 SQL、阶段时序、问题槽位与安全沙箱告警</Text>
            </Box>
            <Box style={{ flex: 1, flexDirection: 'column', gap: 6 }}>
                <Image src='assets/06_metric_miss.png' style={{ width: '100%', height: 200, objectFit: 'contain', border: { width: 1, color: '#D6DCE5' } }} />
                <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#1E4FA8', fontFamily: '微软雅黑' }}>边界提示</Text>
                <Text style={{ fontSize: 15, color: '#8B97A8', fontFamily: '微软雅黑' }}>未命中已登记指标时挂出提示，不静默照常回答</Text>
            </Box>
        </Box>

        <Text style={{ fontSize: 14, color: '#8B97A8', fontFamily: '微软雅黑' }}>
            六张截图均于 2026-09-29 在本机采集，模型为 qwen-plus（LLM_MOCK=false），未做任何界面修饰。
        </Text>
    </Box>

    {/* D 页脚 */}
    <Box style={{ width: '100%', height: 40, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 40px' }}>
        <Text style={{ fontSize: 14, color: '#8B97A8', fontFamily: '微软雅黑' }}>Text2SQL 电商数据分析 Agent</Text>
        <Text style={{ fontSize: 15, color: '#1E4FA8', fontFamily: 'Times New Roman' }}>14 / 16</Text>
    </Box>
</Slide>
