<Slide style={{ background: '#FFFFFF', padding: 0, flexDirection: 'column' }}>
    {/* A3 页眉 */}
    <Box style={{
        width: '100%', height: 72, background: '#0E3F8C',
        flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between',
        padding: '0 40px',
    }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14 }}>
            <Box style={{ width: 5, height: 26, background: '#3D7BD9' }} />
            <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#FFFFFF', fontFamily: '微软雅黑' }}>
                一个会让结论反向的缺陷
            </Text>
        </Box>
        <Text style={{ fontSize: 15, color: 'rgba(255,255,255,0.7)', fontFamily: '微软雅黑' }}>
            可信性设计
        </Text>
    </Box>

    <Box style={{ flex: 1, flexDirection: 'column', padding: '20px 40px 0 40px', gap: 14 }}>
        <Text style={{ fontSize: 21, color: '#4A5568', fontFamily: '微软雅黑' }}>
            评测全绿之后回头翻代码，发现环比基准的窗口计算在非自然月区间上走了一条错误分支。同一个问句，结论方向是反的。
        </Text>

        {/* 上方本期说明 */}
        <Box style={{ width: '100%', height: 62, background: '#F7F9FC', border: { left: { width: 4, color: '#1E4FA8' } }, flexDirection: 'row', alignItems: 'center', padding: '0 20px', gap: 20 }}>
            <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#0E3F8C', fontFamily: '微软雅黑' }}>本期窗口</Text>
            <Text style={{ fontSize: 19, color: '#1A2230', fontFamily: '微软雅黑' }}>2026-08-15 → 2026-09-15　本期成交总额 3,563,928.35 元</Text>
            <Text style={{ fontSize: 17, color: '#8B97A8', fontFamily: '微软雅黑' }}>不是自然月，这是触发缺陷的前提</Text>
        </Box>

        {/* 双栏对照 */}
        <Box style={{ flexDirection: 'row', gap: 18 }}>
            {/* 修复前 */}
            <Box style={{ flex: 1, background: '#FDF3F2', border: { width: 1, color: '#D9534F' }, flexDirection: 'column', padding: 18, gap: 10 }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 9 }}>
                    <Box style={{ width: 66, height: 26, background: '#D9534F', alignItems: 'center', justifyContent: 'center' }}>
                        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#FFFFFF', fontFamily: '微软雅黑' }}>修复前</Text>
                    </Box>
                    <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#0E3F8C', fontFamily: '微软雅黑' }}>按整月对齐</Text>
                </Box>
                <Text style={{ fontSize: 19, color: '#4A5568', fontFamily: '微软雅黑', lineHeight: 1.55 }}>
                    环比窗口取到 2026-07-01 → 2026-08-01。区间与本期不相邻，中间 08-01 至 08-15 半月无人覆盖。
                </Text>
                <Text style={{ fontSize: 64, fontWeight: 'bold', color: '#D9534F', fontFamily: 'Times New Roman', lineHeight: 1 }}>-10.19%</Text>
                <Text style={{ fontSize: 18, color: '#4A5568', fontFamily: '微软雅黑' }}>
                    结论写成「较上月回落约一成」，方向与事实相反。
                </Text>
            </Box>

            {/* 修复后 */}
            <Box style={{ flex: 1, background: '#F0F5FC', border: { width: 1, color: '#1E4FA8' }, flexDirection: 'column', padding: 18, gap: 10 }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 9 }}>
                    <Box style={{ width: 66, height: 26, background: '#1E4FA8', alignItems: 'center', justifyContent: 'center' }}>
                        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#FFFFFF', fontFamily: '微软雅黑' }}>修复后</Text>
                    </Box>
                    <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#0E3F8C', fontFamily: '微软雅黑' }}>紧邻等长平移</Text>
                </Box>
                <Text style={{ fontSize: 19, color: '#4A5568', fontFamily: '微软雅黑', lineHeight: 1.55 }}>
                    环比窗口取到 2026-07-15 → 2026-08-15。紧邻本期且长度一致，两条时间轴严格可比。
                </Text>
                <Text style={{ fontSize: 64, fontWeight: 'bold', color: '#1E4FA8', fontFamily: 'Times New Roman', lineHeight: 1 }}>+8.59%</Text>
                <Text style={{ fontSize: 18, color: '#4A5568', fontFamily: '微软雅黑' }}>
                    结论改成「较上月增长约 8.6%」，本期值未变。
                </Text>
            </Box>
        </Box>

        {/* 根因与修法 */}
        <Box style={{ flexDirection: 'row', gap: 14 }}>
            <Box style={{ flex: 1, background: '#E8EFF8', padding: '12px 18px', flexDirection: 'column', gap: 3 }}>
                <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#0E3F8C', fontFamily: '微软雅黑' }}>根因</Text>
                <Text style={{ fontSize: 17, color: '#4A5568', fontFamily: '微软雅黑', lineHeight: 1.5 }}>
                    基准取值同时支持按月对齐与等长平移，两条路径在非自然月窗口下给出不同结果。
                </Text>
            </Box>
            <Box style={{ flex: 1, background: '#E8EFF8', padding: '12px 18px', flexDirection: 'column', gap: 3 }}>
                <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#0E3F8C', fontFamily: '微软雅黑' }}>修法</Text>
                <Text style={{ fontSize: 17, color: '#4A5568', fontFamily: '微软雅黑', lineHeight: 1.5 }}>
                    先判定窗口是否为自然月，是才走月对齐，否则退回等长平移；自然月语义不变。
                </Text>
            </Box>
            <Box style={{ flex: 1, background: '#E8EFF8', padding: '12px 18px', flexDirection: 'column', gap: 3 }}>
                <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#0E3F8C', fontFamily: '微软雅黑' }}>防线</Text>
                <Text style={{ fontSize: 17, color: '#4A5568', fontFamily: '微软雅黑', lineHeight: 1.5 }}>
                    补一条性质断言：任意窗口下环比必须紧邻且等长，新增粒度同样受约束。
                </Text>
            </Box>
        </Box>

        <Text style={{ fontSize: 14, color: '#8B97A8', fontFamily: '微软雅黑' }}>
            数据与窗口取自 CHANGELOG.md T44 节的端到端记录；单元测试 548 条通过，2026-10-16 本机实跑。
        </Text>
    </Box>

    {/* D 页脚 */}
    <Box style={{ width: '100%', height: 40, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 40px' }}>
        <Text style={{ fontSize: 14, color: '#8B97A8', fontFamily: '微软雅黑' }}>Text2SQL 电商数据分析 Agent</Text>
        <Text style={{ fontSize: 15, color: '#1E4FA8', fontFamily: 'Times New Roman' }}>13 / 16</Text>
    </Box>
</Slide>
