<Slide style={{ background: '#FFFFFF', padding: 0, flexDirection: 'column' }}>
    {/* A3 页眉 */}
    <Box style={{
        width: '100%', height: 72, background: '#0E3F8C',
        flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between',
        padding: '0 40px',
    }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14 }}>
            <Box style={{ width: 5, height: 26, background: '#3D7BD9' }} />
            <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#FFFFFF', fontFamily: '微软雅黑' }}>
                执行前的最后一道闸
            </Text>
        </Box>
        <Text style={{ fontSize: 15, color: 'rgba(255,255,255,0.7)', fontFamily: '微软雅黑' }}>
            系统设计
        </Text>
    </Box>

    <Box style={{ flex: 1, flexDirection: 'column', padding: '20px 40px 0 40px', gap: 14 }}>
        <Text style={{ fontSize: 21, color: '#4A5568', fontFamily: '微软雅黑' }}>
            九条规则按固定顺序执行，任一条不通过就不进入执行环节。只有 R6 会自动改写，其余都是拒绝。
        </Text>

        {/* 第一行 */}
        <Box style={{ flexDirection: 'row', gap: 12 }}>
            <Box style={{ flex: 1, height: 140, background: '#F7F9FC', border: { left: { width: 4, color: '#1E4FA8' } }, flexDirection: 'column', padding: 14, gap: 6 }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 9 }}>
                    <Box style={{ width: 42, height: 24, background: '#1E4FA8', alignItems: 'center', justifyContent: 'center' }}>
                        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#FFFFFF', fontFamily: 'Times New Roman' }}>R1</Text>
                    </Box>
                    <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0E3F8C', fontFamily: '微软雅黑' }}>单条语句</Text>
                </Box>
                <Text style={{ fontSize: 17, color: '#4A5568', fontFamily: '微软雅黑', lineHeight: 1.5 }}>
                    只允许一条语句，出现分号分隔的多条直接拒绝
                </Text>
            </Box>
            <Box style={{ flex: 1, height: 140, background: '#F7F9FC', border: { left: { width: 4, color: '#1E4FA8' } }, flexDirection: 'column', padding: 14, gap: 6 }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 9 }}>
                    <Box style={{ width: 42, height: 24, background: '#1E4FA8', alignItems: 'center', justifyContent: 'center' }}>
                        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#FFFFFF', fontFamily: 'Times New Roman' }}>R2</Text>
                    </Box>
                    <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0E3F8C', fontFamily: '微软雅黑' }}>只允许查询</Text>
                </Box>
                <Text style={{ fontSize: 17, color: '#4A5568', fontFamily: '微软雅黑', lineHeight: 1.5 }}>
                    SELECT 与集合运算之外一律拒绝，用白名单而非黑名单
                </Text>
            </Box>
            <Box style={{ flex: 1, height: 140, background: '#F7F9FC', border: { left: { width: 4, color: '#1E4FA8' } }, flexDirection: 'column', padding: 14, gap: 6 }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 9 }}>
                    <Box style={{ width: 42, height: 24, background: '#1E4FA8', alignItems: 'center', justifyContent: 'center' }}>
                        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#FFFFFF', fontFamily: 'Times New Roman' }}>R3</Text>
                    </Box>
                    <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0E3F8C', fontFamily: '微软雅黑' }}>危险节点</Text>
                </Box>
                <Text style={{ fontSize: 17, color: '#4A5568', fontFamily: '微软雅黑', lineHeight: 1.5 }}>
                    语法树中不得出现 DDL、DML 与管理类关键字
                </Text>
            </Box>
        </Box>

        {/* 第二行 */}
        <Box style={{ flexDirection: 'row', gap: 12 }}>
            <Box style={{ flex: 1, height: 140, background: '#F7F9FC', border: { left: { width: 4, color: '#1E4FA8' } }, flexDirection: 'column', padding: 14, gap: 6 }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 9 }}>
                    <Box style={{ width: 42, height: 24, background: '#1E4FA8', alignItems: 'center', justifyContent: 'center' }}>
                        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#FFFFFF', fontFamily: 'Times New Roman' }}>R4</Text>
                    </Box>
                    <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0E3F8C', fontFamily: '微软雅黑' }}>表必须登记</Text>
                </Box>
                <Text style={{ fontSize: 17, color: '#4A5568', fontFamily: '微软雅黑', lineHeight: 1.5 }}>
                    未在语义层出现的表，按模型编造的表处理
                </Text>
            </Box>
            <Box style={{ flex: 1, height: 140, background: '#F7F9FC', border: { left: { width: 4, color: '#1E4FA8' } }, flexDirection: 'column', padding: 14, gap: 6 }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 9 }}>
                    <Box style={{ width: 42, height: 24, background: '#1E4FA8', alignItems: 'center', justifyContent: 'center' }}>
                        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#FFFFFF', fontFamily: 'Times New Roman' }}>R5</Text>
                    </Box>
                    <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0E3F8C', fontFamily: '微软雅黑' }}>字段必须存在</Text>
                </Box>
                <Text style={{ fontSize: 17, color: '#4A5568', fontFamily: '微软雅黑', lineHeight: 1.5 }}>
                    字段要存在于所属表的元数据中，拼错即拦下
                </Text>
            </Box>
            <Box style={{ flex: 1, height: 140, background: '#E8EFF8', border: { left: { width: 4, color: '#D9534F' } }, flexDirection: 'column', padding: 14, gap: 6 }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 9 }}>
                    <Box style={{ width: 42, height: 24, background: '#D9534F', alignItems: 'center', justifyContent: 'center' }}>
                        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#FFFFFF', fontFamily: 'Times New Roman' }}>R6</Text>
                    </Box>
                    <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0E3F8C', fontFamily: '微软雅黑' }}>行数上限</Text>
                </Box>
                <Text style={{ fontSize: 17, color: '#4A5568', fontFamily: '微软雅黑', lineHeight: 1.5 }}>
                    无 LIMIT 或超限时自动包裹，九条里唯一自动改写的规则
                </Text>
            </Box>
        </Box>

        {/* 第三行 */}
        <Box style={{ flexDirection: 'row', gap: 12 }}>
            <Box style={{ flex: 1, height: 140, background: '#F7F9FC', border: { left: { width: 4, color: '#1E4FA8' } }, flexDirection: 'column', padding: 14, gap: 6 }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 9 }}>
                    <Box style={{ width: 42, height: 24, background: '#1E4FA8', alignItems: 'center', justifyContent: 'center' }}>
                        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#FFFFFF', fontFamily: 'Times New Roman' }}>R7</Text>
                    </Box>
                    <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0E3F8C', fontFamily: '微软雅黑' }}>禁止笛卡尔积</Text>
                </Box>
                <Text style={{ fontSize: 17, color: '#4A5568', fontFamily: '微软雅黑', lineHeight: 1.5 }}>
                    多表查询必须带连接条件，缺 ON 的 JOIN 会被拦下
                </Text>
            </Box>
            <Box style={{ flex: 1, height: 140, background: '#F7F9FC', border: { left: { width: 4, color: '#1E4FA8' } }, flexDirection: 'column', padding: 14, gap: 6 }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 9 }}>
                    <Box style={{ width: 42, height: 24, background: '#1E4FA8', alignItems: 'center', justifyContent: 'center' }}>
                        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#FFFFFF', fontFamily: 'Times New Roman' }}>R8</Text>
                    </Box>
                    <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0E3F8C', fontFamily: '微软雅黑' }}>执行超时</Text>
                </Box>
                <Text style={{ fontSize: 17, color: '#4A5568', fontFamily: '微软雅黑', lineHeight: 1.5 }}>
                    由数据库层的进度回调中断跑太久的查询
                </Text>
            </Box>
            <Box style={{ flex: 1, height: 140, background: '#F7F9FC', border: { left: { width: 4, color: '#1E4FA8' } }, flexDirection: 'column', padding: 14, gap: 6 }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 9 }}>
                    <Box style={{ width: 42, height: 24, background: '#1E4FA8', alignItems: 'center', justifyContent: 'center' }}>
                        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#FFFFFF', fontFamily: 'Times New Roman' }}>R9</Text>
                    </Box>
                    <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0E3F8C', fontFamily: '微软雅黑' }}>函数白名单</Text>
                </Box>
                <Text style={{ fontSize: 17, color: '#4A5568', fontFamily: '微软雅黑', lineHeight: 1.5 }}>
                    只放行白名单内的函数，读文件、加载扩展一类全部挡在门外
                </Text>
            </Box>
        </Box>

        {/* 结论条 */}
        <Box style={{ width: '100%', height: 62, background: '#0E3F8C', flexDirection: 'row', alignItems: 'center', padding: '0 22px', gap: 16 }}>
            <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#FFFFFF', fontFamily: '微软雅黑' }}>纵深不止一层</Text>
            <Text style={{ fontSize: 18, color: 'rgba(255,255,255,0.85)', fontFamily: '微软雅黑' }}>
                守卫之前是模型输出的结构校验，守卫之后还有只读连接、执行超时与结果行数上限。
            </Text>
        </Box>
    </Box>

    {/* D 页脚 */}
    <Box style={{ width: '100%', height: 40, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 40px' }}>
        <Text style={{ fontSize: 14, color: '#8B97A8', fontFamily: '微软雅黑' }}>Text2SQL 电商数据分析 Agent</Text>
        <Text style={{ fontSize: 15, color: '#1E4FA8', fontFamily: 'Times New Roman' }}>09 / 16</Text>
    </Box>
</Slide>
