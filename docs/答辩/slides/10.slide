<Slide style={{ background: '#FFFFFF', padding: 0, flexDirection: 'column' }}>
    {/* A3 页眉 */}
    <Box style={{
        width: '100%', height: 72, background: '#0E3F8C',
        flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between',
        padding: '0 40px',
    }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14 }}>
            <Box style={{ width: 5, height: 26, background: '#3D7BD9' }} />
            <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#FFFFFF', fontFamily: '微软雅黑' }}>
                怎么证明算的是对的量
            </Text>
        </Box>
        <Text style={{ fontSize: 15, color: 'rgba(255,255,255,0.7)', fontFamily: '微软雅黑' }}>
            可信性设计
        </Text>
    </Box>

    <Box style={{ flex: 1, flexDirection: 'column', padding: '20px 40px 0 40px', gap: 12 }}>
        <Text style={{ fontSize: 21, color: '#4A5568', fontFamily: '微软雅黑' }}>
            指标命中、口径也挂对了，生成环节仍可能把聚合写歪。除守卫之外再加一层校验：语句里必须出现这个指标的必要成分。
        </Text>

        {/* 表头 */}
        <Box style={{ flexDirection: 'row', alignItems: 'center', height: 42, background: '#0E3F8C', padding: '0 14px' }}>
            <Text style={{ width: 210, fontSize: 19, fontWeight: 'bold', color: '#FFFFFF', fontFamily: '微软雅黑' }}>指标</Text>
            <Text style={{ flex: 1, fontSize: 19, fontWeight: 'bold', color: '#FFFFFF', fontFamily: '微软雅黑' }}>标准表达式</Text>
            <Text style={{ width: 340, fontSize: 19, fontWeight: 'bold', color: '#FFFFFF', fontFamily: '微软雅黑' }}>签名判据</Text>
        </Box>

        <Box style={{ flexDirection: 'row', alignItems: 'center', height: 44, border: { bottom: { width: 1, color: '#E5E7EB' } }, padding: '0 14px' }}>
            <Text style={{ width: 210, fontSize: 18, fontWeight: 'bold', color: '#1E4FA8', fontFamily: '微软雅黑' }}>成交总额</Text>
            <Text style={{ flex: 1, fontSize: 17, color: '#1A2230', fontFamily: '微软雅黑' }}>SUM(oi.quantity * oi.unit_price)</Text>
            <Text style={{ width: 340, fontSize: 17, color: '#4A5568', fontFamily: '微软雅黑' }}>必须含 unit_price</Text>
        </Box>

        <Box style={{ flexDirection: 'row', alignItems: 'center', height: 44, background: '#F7F9FC', border: { bottom: { width: 1, color: '#E5E7EB' } }, padding: '0 14px' }}>
            <Text style={{ width: 210, fontSize: 18, fontWeight: 'bold', color: '#1E4FA8', fontFamily: '微软雅黑' }}>销量</Text>
            <Text style={{ flex: 1, fontSize: 17, color: '#1A2230', fontFamily: '微软雅黑' }}>SUM(oi.quantity)</Text>
            <Text style={{ width: 340, fontSize: 17, color: '#4A5568', fontFamily: '微软雅黑' }}>必须含 quantity，且不得含 unit_price、cost_price</Text>
        </Box>

        <Box style={{ flexDirection: 'row', alignItems: 'center', height: 44, border: { bottom: { width: 1, color: '#E5E7EB' } }, padding: '0 14px' }}>
            <Text style={{ width: 210, fontSize: 18, fontWeight: 'bold', color: '#1E4FA8', fontFamily: '微软雅黑' }}>订单量</Text>
            <Text style={{ flex: 1, fontSize: 17, color: '#1A2230', fontFamily: '微软雅黑' }}>COUNT(DISTINCT orders.id)</Text>
            <Text style={{ width: 340, fontSize: 17, color: '#4A5568', fontFamily: '微软雅黑' }}>必须含 count(distinct</Text>
        </Box>

        <Box style={{ flexDirection: 'row', alignItems: 'center', height: 44, background: '#F7F9FC', border: { bottom: { width: 1, color: '#E5E7EB' } }, padding: '0 14px' }}>
            <Text style={{ width: 210, fontSize: 18, fontWeight: 'bold', color: '#1E4FA8', fontFamily: '微软雅黑' }}>客单价</Text>
            <Text style={{ flex: 1, fontSize: 17, color: '#1A2230', fontFamily: '微软雅黑' }}>SUM(oi.quantity * oi.unit_price) * 1.0 / COUNT(DISTINCT orders.id)</Text>
            <Text style={{ width: 340, fontSize: 17, color: '#4A5568', fontFamily: '微软雅黑' }}>必须含 unit_price 与 count(distinct，分子分母同源</Text>
        </Box>

        <Box style={{ flexDirection: 'row', alignItems: 'center', height: 44, border: { bottom: { width: 1, color: '#E5E7EB' } }, padding: '0 14px' }}>
            <Text style={{ width: 210, fontSize: 18, fontWeight: 'bold', color: '#1E4FA8', fontFamily: '微软雅黑' }}>退款率</Text>
            <Text style={{ flex: 1, fontSize: 17, color: '#1A2230', fontFamily: '微软雅黑' }}>COUNT(DISTINCT r.order_id) * 1.0 / COUNT(DISTINCT o.id)</Text>
            <Text style={{ width: 340, fontSize: 17, color: '#4A5568', fontFamily: '微软雅黑' }}>必须含 refunds 与 count(distinct，按订单口径</Text>
        </Box>

        <Box style={{ flexDirection: 'row', alignItems: 'center', height: 44, background: '#F7F9FC', border: { bottom: { width: 1, color: '#E5E7EB' } }, padding: '0 14px' }}>
            <Text style={{ width: 210, fontSize: 18, fontWeight: 'bold', color: '#1E4FA8', fontFamily: '微软雅黑' }}>成交用户数</Text>
            <Text style={{ flex: 1, fontSize: 17, color: '#1A2230', fontFamily: '微软雅黑' }}>COUNT(DISTINCT orders.user_id)</Text>
            <Text style={{ width: 340, fontSize: 17, color: '#4A5568', fontFamily: '微软雅黑' }}>必须含 user_id</Text>
        </Box>

        <Box style={{ flexDirection: 'row', alignItems: 'center', height: 44, border: { bottom: { width: 1, color: '#E5E7EB' } }, padding: '0 14px' }}>
            <Text style={{ width: 210, fontSize: 18, fontWeight: 'bold', color: '#1E4FA8', fontFamily: '微软雅黑' }}>毛利</Text>
            <Text style={{ flex: 1, fontSize: 17, color: '#1A2230', fontFamily: '微软雅黑' }}>SUM(oi.quantity * (oi.unit_price - p.cost_price))</Text>
            <Text style={{ width: 340, fontSize: 17, color: '#4A5568', fontFamily: '微软雅黑' }}>必须含 cost_price，否则只是把成交额改名</Text>
        </Box>

        {/* 结论条 */}
        <Box style={{ width: '100%', height: 66, background: '#E8EFF8', border: { left: { width: 5, color: '#1E4FA8' } }, flexDirection: 'column', justifyContent: 'center', padding: '0 22px', gap: 2 }}>
            <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#0E3F8C', fontFamily: '微软雅黑' }}>
                这类失败形态是唯一会让用户拿着错误数字而不自知的
            </Text>
            <Text style={{ fontSize: 17, color: '#4A5568', fontFamily: '微软雅黑' }}>
                语句能执行、结果有数据、图表正常、全程不报错。守卫管语句安不安全，签名管算的是不是那个量。
            </Text>
        </Box>

        <Text style={{ fontSize: 14, color: '#8B97A8', fontFamily: '微软雅黑' }}>
            签名取自 backend/app/semantic/metrics.yaml 的 expression_signature 字段；校验器为 app/semantic/expression_check.py。
        </Text>
    </Box>

    {/* D 页脚 */}
    <Box style={{ width: '100%', height: 40, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 40px' }}>
        <Text style={{ fontSize: 14, color: '#8B97A8', fontFamily: '微软雅黑' }}>Text2SQL 电商数据分析 Agent</Text>
        <Text style={{ fontSize: 15, color: '#1E4FA8', fontFamily: 'Times New Roman' }}>10 / 16</Text>
    </Box>
</Slide>
