<Slide style={{ background: '#FFFFFF', padding: 0, flexDirection: 'column' }}>
    {/* A3 页眉 */}
    <Box style={{
        width: '100%', height: 72, background: '#0E3F8C',
        flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between',
        padding: '0 40px',
    }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14 }}>
            <Box style={{ width: 5, height: 26, background: '#3D7BD9' }} />
            <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#FFFFFF', fontFamily: '微软雅黑' }}>
                做到什么程度才算成
            </Text>
        </Box>
        <Text style={{ fontSize: 15, color: 'rgba(255,255,255,0.7)', fontFamily: '微软雅黑' }}>
            选题背景
        </Text>
    </Box>

    <Box style={{ flex: 1, flexDirection: 'column', padding: '32px 40px 0 40px', gap: 22 }}>
        {/* 引导句 */}
        <Text style={{ fontSize: 22, color: '#4A5568', fontFamily: '微软雅黑' }}>
            三条验收判据先定下来，再做实现。每一条都落到可以逐项核对的机制上，而不是一句「能跑通」。
        </Text>

        {/* KPI 四联数 */}
        <Box style={{ flexDirection: 'row', gap: 18 }}>
            <Box style={{ flex: 1, height: 148, background: '#F0F5FC', border: { top: { width: 4, color: '#1E4FA8' } }, flexDirection: 'column', justifyContent: 'center', alignItems: 'center', gap: 6 }}>
                <Text style={{ fontSize: 72, fontWeight: 'bold', color: '#0E3F8C', fontFamily: 'Times New Roman', lineHeight: 1 }}>7</Text>
                <Text style={{ fontSize: 17, color: '#4A5568', fontFamily: '微软雅黑' }}>语义层登记指标</Text>
            </Box>
            <Box style={{ flex: 1, height: 148, background: '#F0F5FC', border: { top: { width: 4, color: '#1E4FA8' } }, flexDirection: 'column', justifyContent: 'center', alignItems: 'center', gap: 6 }}>
                <Text style={{ fontSize: 72, fontWeight: 'bold', color: '#0E3F8C', fontFamily: 'Times New Roman', lineHeight: 1 }}>9</Text>
                <Text style={{ fontSize: 17, color: '#4A5568', fontFamily: '微软雅黑' }}>SQL 守卫规则</Text>
            </Box>
            <Box style={{ flex: 1, height: 148, background: '#F0F5FC', border: { top: { width: 4, color: '#1E4FA8' } }, flexDirection: 'column', justifyContent: 'center', alignItems: 'center', gap: 6 }}>
                <Text style={{ fontSize: 72, fontWeight: 'bold', color: '#0E3F8C', fontFamily: 'Times New Roman', lineHeight: 1 }}>14</Text>
                <Text style={{ fontSize: 17, color: '#4A5568', fontFamily: '微软雅黑' }}>状态机节点</Text>
            </Box>
            <Box style={{ flex: 1, height: 148, background: '#E8EFF8', border: { top: { width: 4, color: '#D9534F' } }, flexDirection: 'column', justifyContent: 'center', alignItems: 'center', gap: 6 }}>
                <Text style={{ fontSize: 72, fontWeight: 'bold', color: '#0E3F8C', fontFamily: 'Times New Roman', lineHeight: 1 }}>548</Text>
                <Text style={{ fontSize: 17, color: '#4A5568', fontFamily: '微软雅黑' }}>单元测试通过</Text>
            </Box>
        </Box>

        {/* 验收口径表 */}
        <Table
            style={{ width: '100%', height: 246 }}
            defaultTextStyle={{ fontSize: 18, textAlign: 'left', color: '#1A2230', fontFamily: '微软雅黑' }}
            defaultCellStyle={{
                border: {
                    left: { width: 1, color: '#D6DCE5' },
                    right: { width: 1, color: '#D6DCE5' },
                    top: { width: 1, color: '#D6DCE5' },
                    bottom: { width: 1, color: '#D6DCE5' },
                },
                padding: { left: 16, right: 16, top: 10, bottom: 10 },
            }}
            cells={[
                [
                    { text: '验收维度', textStyle: { bold: true, color: '#FFFFFF', fontSize: 19 }, cellStyle: { background: { color: '#0E3F8C' } } },
                    { text: '判据', textStyle: { bold: true, color: '#FFFFFF', fontSize: 19 }, cellStyle: { background: { color: '#0E3F8C' } } },
                    { text: '当前状态（实测）', textStyle: { bold: true, color: '#FFFFFF', fontSize: 19 }, cellStyle: { background: { color: '#0E3F8C' } } },
                ],
                [
                    { text: '口径可追溯', textStyle: { bold: true, color: '#1E4FA8' } },
                    '每个业务指标的聚合表达式在语义层显式声明，不由模型临场决定',
                    { text: '7 个指标全部登记，含必带过滤条件与口径边界说明', textStyle: { color: '#4A5568' } },
                ],
                [
                    { text: '过程可核对', textStyle: { bold: true, color: '#1E4FA8' }, cellStyle: { background: { color: '#F7F9FC' } } },
                    { text: '每轮回答可展开执行的 SQL、阶段时序与采用的指标口径', cellStyle: { background: { color: '#F7F9FC' } } },
                    { text: '14 节点全链路留痕，前端逐项可查', textStyle: { color: '#4A5568' }, cellStyle: { background: { color: '#F7F9FC' } } },
                ],
                [
                    { text: '越权不发生', textStyle: { bold: true, color: '#1E4FA8' } },
                    '非查询语句、未登记的表与字段，在执行之前就被拒绝',
                    { text: '9 条规则 + 548 条测试覆盖，安全组 8 项全通过', textStyle: { color: '#4A5568' } },
                ],
            ]}
        />

        <Text style={{ fontSize: 14, color: '#8B97A8', fontFamily: '微软雅黑' }}>
            数据来源：GET /api/health 与 backend/app/db/guard.py、agent/graph.py；测试数取自 2026-10-16 本机 pytest -q 实跑结果。
        </Text>
    </Box>

    {/* D 页脚 */}
    <Box style={{ width: '100%', height: 40, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 40px' }}>
        <Text style={{ fontSize: 14, color: '#8B97A8', fontFamily: '微软雅黑' }}>Text2SQL 电商数据分析 Agent</Text>
        <Text style={{ fontSize: 15, color: '#1E4FA8', fontFamily: 'Times New Roman' }}>04 / 16</Text>
    </Box>
</Slide>
