<Slide style={{ background: '#FFFFFF', padding: 0, flexDirection: 'column' }}>
    {/* A3 页眉 */}
    <Box style={{
        width: '100%', height: 72, background: '#0E3F8C',
        flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between',
        padding: '0 40px',
    }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14 }}>
            <Box style={{ width: 5, height: 26, background: '#3D7BD9' }} />
            <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#FFFFFF', fontFamily: '微软雅黑' }}>
                六层职责，单进程部署
            </Text>
        </Box>
        <Text style={{ fontSize: 15, color: 'rgba(255,255,255,0.7)', fontFamily: '微软雅黑' }}>
            系统设计
        </Text>
    </Box>

    <Box style={{ flex: 1, flexDirection: 'column', padding: '28px 40px 0 40px', gap: 18 }}>
        {/* 六层分层图 */}
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
            <Box style={{ width: 168, height: 52, background: '#0E3F8C', borderRadius: 3, alignItems: 'center', justifyContent: 'center' }}>
                <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#FFFFFF', fontFamily: 'Times New Roman' }}>api</Text>
            </Box>
            <Box style={{ flex: 1, height: 52, background: '#F7F9FC', border: { left: { width: 3, color: '#0E3F8C' } }, flexDirection: 'row', alignItems: 'center', padding: '0 18px' }}>
                <Text style={{ fontSize: 21, color: '#1A2230', fontFamily: '微软雅黑' }}>
                    接口层 · FastAPI 路由、SSE 流式推送、会话与审计查询
                </Text>
            </Box>
        </Box>

        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
            <Box style={{ width: 168, height: 52, background: '#0E3F8C', borderRadius: 3, alignItems: 'center', justifyContent: 'center' }}>
                <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#FFFFFF', fontFamily: 'Times New Roman' }}>agent</Text>
            </Box>
            <Box style={{ flex: 1, height: 52, background: '#F7F9FC', border: { left: { width: 3, color: '#0E3F8C' } }, flexDirection: 'row', alignItems: 'center', padding: '0 18px' }}>
                <Text style={{ fontSize: 21, color: '#1A2230', fontFamily: '微软雅黑' }}>
                    编排层 · LangGraph 状态机，十四个节点与重试回环
                </Text>
            </Box>
        </Box>

        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
            <Box style={{ width: 168, height: 52, background: '#1E4FA8', borderRadius: 3, alignItems: 'center', justifyContent: 'center' }}>
                <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#FFFFFF', fontFamily: 'Times New Roman' }}>semantic</Text>
            </Box>
            <Box style={{ flex: 1, height: 52, background: '#F7F9FC', border: { left: { width: 3, color: '#1E4FA8' } }, flexDirection: 'row', alignItems: 'center', padding: '0 18px' }}>
                <Text style={{ fontSize: 21, color: '#1A2230', fontFamily: '微软雅黑' }}>
                    语义层 · 指标口径与表元数据，纯函数，不调模型也不连库
                </Text>
            </Box>
        </Box>

        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
            <Box style={{ width: 168, height: 52, background: '#1E4FA8', borderRadius: 3, alignItems: 'center', justifyContent: 'center' }}>
                <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#FFFFFF', fontFamily: 'Times New Roman' }}>llm</Text>
            </Box>
            <Box style={{ flex: 1, height: 52, background: '#F7F9FC', border: { left: { width: 3, color: '#1E4FA8' } }, flexDirection: 'row', alignItems: 'center', padding: '0 18px' }}>
                <Text style={{ fontSize: 21, color: '#1A2230', fontFamily: '微软雅黑' }}>
                    模型层 · Prompt 组装、结构化输出校验、失败重试与降级
                </Text>
            </Box>
        </Box>

        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
            <Box style={{ width: 168, height: 52, background: '#3D7BD9', borderRadius: 3, alignItems: 'center', justifyContent: 'center' }}>
                <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#FFFFFF', fontFamily: 'Times New Roman' }}>db</Text>
            </Box>
            <Box style={{ flex: 1, height: 52, background: '#F7F9FC', border: { left: { width: 3, color: '#3D7BD9' } }, flexDirection: 'row', alignItems: 'center', padding: '0 18px' }}>
                <Text style={{ fontSize: 21, color: '#1A2230', fontFamily: '微软雅黑' }}>
                    数据层 · Repository 抽象、九条 SQL 守卫、SQLite 只读连接
                </Text>
            </Box>
        </Box>

        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
            <Box style={{ width: 168, height: 52, background: '#3D7BD9', borderRadius: 3, alignItems: 'center', justifyContent: 'center' }}>
                <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#FFFFFF', fontFamily: 'Times New Roman' }}>chart</Text>
            </Box>
            <Box style={{ flex: 1, height: 52, background: '#F7F9FC', border: { left: { width: 3, color: '#3D7BD9' } }, flexDirection: 'row', alignItems: 'center', padding: '0 18px' }}>
                <Text style={{ fontSize: 21, color: '#1A2230', fontFamily: '微软雅黑' }}>
                    展现层 · 图型选择规则与 ECharts 配置生成，前端只负责渲染
                </Text>
            </Box>
        </Box>

        {/* 三条硬约束 */}
        <Box style={{ flexDirection: 'row', gap: 14, marginTop: 4 }}>
            <Box style={{ flex: 1, background: '#E8EFF8', padding: '12px 16px', flexDirection: 'column', gap: 4 }}>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0E3F8C', fontFamily: '微软雅黑' }}>约束一</Text>
                <Text style={{ fontSize: 18, color: '#4A5568', fontFamily: '微软雅黑', lineHeight: 1.5 }}>
                    节点层不出现数据库连接，只能调仓储层暴露的方法
                </Text>
            </Box>
            <Box style={{ flex: 1, background: '#E8EFF8', padding: '12px 16px', flexDirection: 'column', gap: 4 }}>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0E3F8C', fontFamily: '微软雅黑' }}>约束二</Text>
                <Text style={{ fontSize: 18, color: '#4A5568', fontFamily: '微软雅黑', lineHeight: 1.5 }}>
                    语义层不调用模型、不执行 SQL，保持纯函数
                </Text>
            </Box>
            <Box style={{ flex: 1, background: '#E8EFF8', padding: '12px 16px', flexDirection: 'column', gap: 4 }}>
                <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0E3F8C', fontFamily: '微软雅黑' }}>约束三</Text>
                <Text style={{ fontSize: 18, color: '#4A5568', fontFamily: '微软雅黑', lineHeight: 1.5 }}>
                    密钥只出现在环境配置，代码与配置文件中不出现字面量
                </Text>
            </Box>
        </Box>
    </Box>

    {/* D 页脚 */}
    <Box style={{ width: '100%', height: 40, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 40px' }}>
        <Text style={{ fontSize: 14, color: '#8B97A8', fontFamily: '微软雅黑' }}>Text2SQL 电商数据分析 Agent</Text>
        <Text style={{ fontSize: 15, color: '#1E4FA8', fontFamily: 'Times New Roman' }}>05 / 16</Text>
    </Box>
</Slide>
