                </Box>
                <Box style={{ flexDirection: 'row', alignItems: 'center', height: 28, border: { bottom: { width: 1, color: '#E5E7EB' } }, padding: '0 12px' }}>
                    <Text style={{ width: 186, fontSize: 15, color: '#1A2230', fontFamily: '微软雅黑' }}>召回命中 recall</Text>
                    <Text style={{ flex: 1, fontSize: 15, color: '#4A5568', fontFamily: '微软雅黑', textAlign: 'center' }}>45</Text>
                    <Text style={{ flex: 1, fontSize: 15, fontWeight: 'bold', color: '#1E4FA8', fontFamily: '微软雅黑', textAlign: 'center' }}>45</Text>
                    <Text style={{ flex: 1, fontSize: 15, color: '#8B97A8', fontFamily: '微软雅黑', textAlign: 'center' }}>0</Text>
                </Box>
