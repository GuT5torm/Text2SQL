                    <Text style={{ flex: 1, fontSize: 15, color: '#4A5568', fontFamily: '微软雅黑', textAlign: 'center' }}>7</Text>
                    <Text style={{ flex: 1, fontSize: 15, fontWeight: 'bold', color: '#1E4FA8', fontFamily: '微软雅黑', textAlign: 'center' }}>7</Text>
                    <Text style={{ flex: 1, fontSize: 15, color: '#8B97A8', fontFamily: '微软雅黑', textAlign: 'center' }}>0</Text>
