                    <Text style={{ width: 186, fontSize: 15, fontWeight: 'bold', color: '#FFFFFF', fontFamily: '微软雅黑' }}>合计</Text>
                    <Text style={{ flex: 1, fontSize: 15, fontWeight: 'bold', color: '#FFFFFF', fontFamily: '微软雅黑', textAlign: 'center' }}>108</Text>
                    <Text style={{ flex: 1, fontSize: 15, fontWeight: 'bold', color: '#FFFFFF', fontFamily: '微软雅黑', textAlign: 'center' }}>103</Text>
                    <Text style={{ flex: 1, fontSize: 15, fontWeight: 'bold', color: '#FFFFFF', fontFamily: '微软雅黑', textAlign: 'center' }}>5</Text>
