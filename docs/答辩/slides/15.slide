                    <Text style={{ flex: 1, fontSize: 15, color: '#4A5568', fontFamily: '微软雅黑', textAlign: 'center' }}>6</Text>
                    <Text style={{ flex: 1, fontSize: 15, fontWeight: 'bold', color: '#1E4FA8', fontFamily: '微软雅黑', textAlign: 'center' }}>5</Text>
                    <Text style={{ flex: 1, fontSize: 15, color: '#8B97A8', fontFamily: '微软雅黑', textAlign: 'center' }}>1</Text>
                </Box>
                <Box style={{ flexDirection: 'row', alignItems: 'center', height: 28, background: '#F7F9FC', border: { bottom: { width: 1, color: '#E5E7EB' } }, padding: '0 12px' }}>
                    <Text style={{ width: 186, fontSize: 15, color: '#1A2230', fontFamily: '微软雅黑' }}>进阶语法 advanced</Text>
                    <Text style={{ flex: 1, fontSize: 15, color: '#4A5568', fontFamily: '微软雅黑', textAlign: 'center' }}>3</Text>
